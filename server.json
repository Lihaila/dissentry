{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Lihaila/dissentry",
  "title": "Dissentry",
  "description": "Multi-model AI fact-checker (Community Notes for AI) and second opinion across LLM families.",
  "websiteUrl": "https://dissentry.lihaila.com/mcp",
  "icons": [
    {
      "src": "https://dissentry.lihaila.com/icon-192.png",
      "mimeType": "image/png",
      "sizes": ["192x192"]
    }
  ],
  "repository": {
    "url": "https://github.com/Lihaila/dissentry",
    "source": "github"
  },
  "version": "0.9.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "dissentry",
      "version": "0.9.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "isRequired": true
        }
      ],
      "environmentVariables": [
        {
          "name": "OPENROUTER_API_KEY",
          "description": "Optional OpenRouter API key (not needed if models are already configured via npx dissentry in ~/.dissentry/data.json).",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://dissentry.lihaila.com/v1/mcp"
    }
  ]
}
